# NSE Tick Collector — Configuration Template
#
# इस file को `.env` के नाम से copy करें और अपनी values भरें।
# नोट: comments अलग lines में रखें — systemd EnvironmentFile inline-comments
# parse नहीं करता।

# ----- OpenAlgo API -----
# अपनी OpenAlgo dashboard से API key copy करें
OPENALGO_API_KEY=your_api_key_here

# REST API host (local OpenAlgo के लिए default)
OPENALGO_HOST=http://127.0.0.1:5000

# WebSocket host (live tick stream के लिए)
OPENALGO_WS_URL=ws://127.0.0.1:8765

# ----- TimescaleDB connection -----
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=marketdata
PG_USER=marketdata
PG_PASSWORD=change_me

# ----- Collector tuning -----
# Exchange (NSE / BSE)
EXCHANGE=NSE

# Symbols की list वाली file
SYMBOLS_FILE=symbols.txt

# Subscription mode:
#   quote — Level-1 (LTP + best bid/ask + volume)
#   depth — Level-2 (पूरा order book + LTP/volume सब)
# 'both' allowed नहीं (CAGG में duplicate counting bug था)
MODE=quote

# कितने ticks जमा होने पर एक batch insert मारें
BATCH_SIZE=500

# या इतने सेकंड में force flush (जो पहले हो)
FLUSH_INTERVAL_SEC=1

# Reconnect attempt के बीच maximum delay (exponential backoff cap)
RECONNECT_MAX_DELAY=60

# Watchdog: इतनी देर tick न आए तो stale मानकर reconnect
# (low-liquidity stocks में false-positive avoid करने के लिए 60s default)
WATCHDOG_TIMEOUT_SEC=60

# Same-day reconnect spike protection:
# इतने seconds बिना tick के बाद आया tick = reconnect माना जाता है,
# cumulative volume का delta को एक tick में credit नहीं करते
# (gap_filler उस window को history से भर देगा)
RECONNECT_GAP_THRESHOLD_SEC=60

# DB fail या queue full पर failed rows यहाँ JSONL में spool होंगी,
# startup पर auto-replay
SPOOL_DIR=./spool

# हर tick का पूरा raw payload भी DB में store करें?
# (storage भारी हो जाता है — सिर्फ़ debugging के लिए true करें)
STORE_RAW_PAYLOAD=false

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
